# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Claude Code session state
.claude/scheduled_tasks.lock

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local outputs (training logs, ckpts, etc. live outside the repo)
*.log

# Experiment outputs / checkpoints (large, machine-specific — never commit)
exp/
logs/
tensorboard/
# ...but env/hpc/slurm/logs/ must EXIST in a fresh clone: Slurm creates the
# `#SBATCH -o env/hpc/slurm/logs/...` file *before* the job script runs, so if the
# directory is missing the job dies at launch with no output anywhere (2026-08-26).
# The bare `logs/` rule above matches it at any depth, hence these negations —
# the directory has to be re-included before the file inside it can be.
!env/hpc/slurm/logs/
!env/hpc/slurm/logs/.gitkeep
*.pth
*.pt
*.ckpt
events.out.tfevents.*
val_images/

# Data (lives outside the repo)
*.nii
*.nii.gz

# Python env
.venv/
*.egg-info/

# Patent drafts — LOCAL ONLY, never committed (2026-08-26).
# The patent is not yet filed and this repo is public, so committing these would
# be a novelty-destroying public disclosure. docs/v35_paper/README.md records the
# rule as "patent-first: file before publishing". They were purged from history
# with git filter-repo; keep your local copies outside version control.
docs/patent_draft.md
docs/v35_patent_version.md

# Baidu Sync temp files (this working copy lives inside BaiduSyncdisk)
*.baiduyun.uploading.cfg

# Paper / strategy documents — LOCAL ONLY (2026-08-26, option B).
# The repo is public. Engineering docs stay; what a competitor could act on does not:
# the unrun experiment matrix, the submission target, and the prior-art positioning.
# Purged from history with git filter-repo; local working copies are untouched.
docs/v35_paper/
docs/publishability_precedents.md
docs/related_work.md
